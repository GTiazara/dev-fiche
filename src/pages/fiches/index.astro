---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FicheCard from '../../components/FicheCard.astro';
import FicheFilters from '../../components/FicheFilters.vue';
import { publishedFiches, sortByUpdatedDesc, toSearchDocument } from '../../lib/fiches';
import { technologies } from '../../data/technologies';

const published = sortByUpdatedDesc(publishedFiches(await getCollection('fiches')));
const cards = published.map((entry) => toSearchDocument(entry, import.meta.env.BASE_URL));
const visibleTechnologies = technologies.filter((item) =>
  published.some((entry) => entry.data.technology === item.slug),
);
---
<Base title="Fiches — DevFiches" description="Toutes les fiches publiées, filtrables par technologie et par niveau.">
  <h1>Toutes les fiches</h1>
  <FicheFilters
    client:load
    listId="catalogue"
    emptyId="catalogue-vide"
    showTechnology={true}
    technologies={visibleTechnologies}
  />
  <p id="catalogue-vide" class="empty" hidden>Aucune fiche ne correspond à ces filtres.</p>
  <ul id="catalogue" class="card-grid">
    {cards.map((card) => (
      <FicheCard
        title={card.title}
        description={card.description}
        technology={card.technology}
        technologyLabel={card.technologyLabel}
        difficulty={card.difficulty}
        difficultyLabel={card.difficultyLabel}
        minutes={card.minutes}
        href={card.href}
        image={card.image}
        imageAlt={card.imageAlt}
      />
    ))}
  </ul>
</Base>
