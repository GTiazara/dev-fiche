---
interface Props {
  title: string;
  description: string;
  technologies: { slug: string; label: string; href: string }[];
  difficulty: string;
  difficultyLabel: string;
  minutes: number;
  href: string;
  image?: string;
  imageAlt?: string;
}
const props = Astro.props;
---
<li
  class="card"
  data-technology={props.technologies.map((item) => item.slug).join(' ')}
  data-difficulty={props.difficulty}
>
  {props.image && <img class="card-image" src={props.image} alt={props.imageAlt ?? ''} loading="lazy" />}
  <span class="badges">
    {props.technologies.map((item) => (
      <a class="badge" href={item.href}>{item.label}</a>
    ))}
    <span class="badge neutral">{props.difficultyLabel}</span>
  </span>
  <h2><a href={props.href}>{props.title}</a></h2>
  <p>{props.description}</p>
  <p class="meta">{props.minutes} min</p>
</li>
